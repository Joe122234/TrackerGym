rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // FORGE deliberately has no login. Every device reads and writes the same
    // single-user namespace. This means anyone who has the app link can read
    // or change the log. That is the accepted trade-off for automatic sync
    // across devices without accounts.
    match /users/shared {
      allow read, write: if true;
    }

    match /users/shared/{document=**} {
      allow read, write: if true;
    }

    // Legacy data from the previous per-browser anonymous build. These paths
    // remain available only to their old signed-in owner so the app can copy
    // existing workouts into the shared log once.
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/settings/{settingId} {
      allow read, write: if isOwner(uid)
        && settingId in ['profile', 'preferences'];
    }

    match /users/{uid}/meta/{metaId} {
      allow read, write: if isOwner(uid)
        && metaId == 'initialization';
    }

    match /users/{uid}/exerciseDefinitions/{exerciseId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/workoutTemplates/{templateId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/weeklySchedule/{day} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/workoutSessions/{sessionId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/bodyMeasurements/{measurementId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/personalRecords/{recordId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/achievements/{achievementId} {
      allow read, write: if isOwner(uid);
    }
  }
}
