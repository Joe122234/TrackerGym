rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Every document lives under the signed-in user's namespace. Unknown
    // subcollections are denied implicitly. Cross-account reads and writes
    // must never be possible.
    match /users/{uid}/settings/{settingId} {
      allow read, write: if isOwner(uid)
        && settingId in ['profile', 'preferences'];
    }

    match /users/{uid}/meta/{metaId} {
      allow read, write: if isOwner(uid)
        && metaId == 'initialization';
    }

    match /users/{uid}/exerciseDefinitions/{exerciseId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/workoutTemplates/{templateId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/weeklySchedule/{day} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/workoutSessions/{sessionId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/bodyMeasurements/{measurementId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/personalRecords/{recordId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/achievements/{achievementId} {
      allow read, write: if isOwner(uid);
    }
  }
}
